{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "LocalOS",
    "version": "0.1.0",
    "identifier": "dev.localos.app",
    "build": {
        "frontendDist": "./ui"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "LocalOS",
                "width": 900,
                "height": 600,
                "resizable": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/icon.png"
        ]
    }
}